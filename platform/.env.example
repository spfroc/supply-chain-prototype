COMPOSE_PROJECT_NAME=supply-chain
MYSQL_DATABASE=supply_chain
MYSQL_USER=supply_chain
MYSQL_PASSWORD=change_me_database_password
DB_HOST=192.168.0.241
DB_PORT=3306
REDIS_PASSWORD=change_me_redis_password
JWT_SECRET=replace_with_at_least_32_random_characters
APP_PUBLIC_HOST=supply.huiecai.com
APP_HTTP_PORT=127.0.0.1:18089
APP_DOMAIN=supply.huiecai.com
TRAEFIK_ENABLE=true
GLOBAL_NETWORK_NAME=prod.host
TZ=Asia/Shanghai

# 外部服务仅在服务器环境变量中填写，不提交真实密钥
AMAP_API_KEY=
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_PUBLIC_URL=https://huiecai.oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_OBJECT_PREFIX=supply-chain/
ALIYUN_OSS_MIGRATE_LOCAL_ON_START=false
SMS_BASE_URL=
SMS_APP_KEY=
# 淘宝/天猫采集专用账号的 Cookie（至少包含 _m_h5_tk；仅写入服务器 .env，禁止提交）
TAOBAO_MTOP_COOKIE=
